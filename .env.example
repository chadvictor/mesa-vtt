# =============================================================================
# Mesa VTT — Runtime Configuration Example
# Copy to `.env` for local or Docker Compose customization.
# All variables are OPTIONAL: Mesa VTT runs zero-config out of the box!
# =============================================================================

# HTTP / WebSocket listen address (default: :8094)
LISTEN_ADDRESS=:8094

# Authentication mode:
# - "local" (default): standalone quick login (name + avatar) enabled out of the box
# - "sso": disables local login and requires EXTERNAL_TICKET_URL + EXTERNAL_AUTH_TOKEN
AUTH_MODE=local

# Persistence:
# Leave DATABASE_URL empty to use the built-in zero-config atomic JSON FileStore.
# Set DATABASE_URL to use PostgreSQL (tables mesa_* are auto-migrated on startup).
DATABASE_URL=
# DATABASE_URL=postgres://mesa:mesa_dev_password@postgres:5432/mesa_vtt?sslmode=disable

# Path for the atomic JSON FileStore when DATABASE_URL is empty
# (default: ./.mesa-vtt-data.json, or /data/mesa-vtt-data.json in Docker)
MESA_DATA_FILE=./.mesa-vtt-data.json

# HMAC-SHA256 secret used to sign session tokens (min 32 random chars recommended).
# If empty, a cryptographically random secret is generated on each startup.
SESSION_SECRET=

# Public origin URL for CORS and WebSocket Origin enforcement in production.
# Example: https://mesa.example.org
APP_ORIGIN=

# WebRTC STUN / TURN servers for Discord-style integrated voice chat (JSON array).
# Defaults to public Google STUN servers. Add a TURN server (e.g. coturn) for
# players behind strict corporate or mobile carrier NATs.
# MESA_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.org:3478","username":"mesa","credential":"secret"}]
MESA_ICE_SERVERS=

# Optional: Gemini API key for in-app AI battlemap & portrait generation
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: External SSO one-time launch ticket verification (used when AUTH_MODE=sso)
# Mesa VTT POSTs {"ticket":"..."} with Authorization: Bearer <EXTERNAL_AUTH_TOKEN>
# and expects 200 JSON: {"id","display_name","avatar_url"?,"room_id"?,"create"?,"is_admin"?}
EXTERNAL_TICKET_URL=
EXTERNAL_AUTH_TOKEN=

# Optional: Directory containing the built React SPA (set automatically to /app/web in Docker)
# STATIC_DIR=./client/dist
